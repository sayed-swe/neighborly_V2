NODE_ENV=development
PORT=4000
# Leave empty in development to use the built-in local database (server/.data).
# Production: MongoDB Atlas free M0 cluster connection string.
MONGODB_URI=
CLIENT_URL=http://localhost:3000
EXTRA_ORIGINS=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# strict when web and API share a site (Vite proxy / Vercel rewrite). Use none + COOKIE_SECURE=true if cross-site.
COOKIE_SAMESITE=strict
# Number of proxies in front of the app (1 on Render)
TRUST_PROXY=0
BCRYPT_ROUNDS=12
# --- Email (SMTP) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# Leave SMTP_USER/SMTP_PASS empty to print emails in this terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# With Gmail, MAIL_FROM must use the same address as SMTP_USER
MAIL_FROM=

# --- Google sign-in (OAuth 2.0 Web client) ---
# Authorised redirect URI in Google Cloud Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Image storage (Cloudinary, free tier) ---
# Without these, uploaded photos are saved in server/uploads/, which free hosts
# like Render wipe on every deploy. Copy them from cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=neighborly
